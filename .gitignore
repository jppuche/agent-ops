# Credentials / secrets
.env
.env.*
!.env.example
*.pwd
credentials.json
secrets/

# Node (instances that ship a pipeline)
node_modules/
.wrangler/
dist/

# System / IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Output drafts (local only)
outputs/drafts/

# Hook state (markers, counters, usage indexes; only when no session scratchpad)
outputs/fanouts/_state/

# Hook logs: raw dispatched prompts (may carry project / client data) and the MCP audit log
outputs/fanouts/_dispatched-prompts.jsonl
# Hand-backs filed by system/scripts/extract-handbacks.ps1 (verbatim agent text, redacted by shape only)
outputs/fanouts/_handbacks/
# Hook error logs: exception text can carry local paths (user names)
outputs/fanouts/*.errors.log
.claude/security/

# Claude Code working files (local only)
.claude/sessions/
.claude/cache/
.claude/settings.local.json

# Python bytecode
__pycache__/
